{
  "name": "llm-cost-guardian",
  "version": "0.1.0",
  "description": "FinOps for LLM usage: ingest cost events, enforce budgets, detect spend anomalies, attribute cost by team/key/model.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "llm-cost-guardian": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.64.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
